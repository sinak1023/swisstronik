# Port the dashboard listens on
PORT=3000

# Session cookie secret - set this to a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Admin login credentials
# Generate ADMIN_PASSWORD_HASH with: npm run hash-password -- "your-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Set to "true" when the app is served over HTTPS (enables secure session cookies)
COOKIE_SECURE=false

# Delay in milliseconds between two consecutive messages sent to Bale (throttling)
BROADCAST_DELAY_MS=350
