# ===== Bale Bot =====
# Token from @BotFather on Bale
BALE_BOT_TOKEN=your_bot_token_here
# Bale API base (usually no need to change)
BALE_API_BASE=https://tapi.bale.ai

# ===== Web server =====
PORT=3000
# Secret used to sign JWT auth tokens (CHANGE THIS!)
JWT_SECRET=change_me_to_a_long_random_string

# ===== First admin (created on first run if no admin exists) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# ===== Outgoing message rate limit (to avoid Bale limits) =====
# Minimum gap between two outgoing API calls, in milliseconds
BALE_MIN_INTERVAL_MS=350

# Public base URL of this panel (used in links shown to agents/admin), optional
PUBLIC_BASE_URL=http://localhost:3000
