# Install:  sudo cp deploy/attestra.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now attestra
# Adjust WorkingDirectory / User / PORT to your setup.

[Unit]
Description=Attestra static server (Arc invoice dApp)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/attestra
Environment=PORT=8080
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node /opt/attestra/backend/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
