# Copy to .env and fill in. NEVER commit .env.

# Arc Testnet RPC (default is fine)
ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.network"

# Deployer wallet private key (must hold testnet USDC for gas — get it at faucet.circle.com)
PRIVATE_KEY="0xYOUR_PRIVATE_KEY_HERE"

# Wallet that collects the platform fee (defaults to the deployer if omitted)
FEE_RECIPIENT="0xYOUR_FEE_WALLET_HERE"

# Platform fee in basis points. 200 = 2.00%. Hard-capped at 500 (5%) in the contract.
FEE_BPS="200"

# Static server port (backend/server.js)
PORT="8080"
